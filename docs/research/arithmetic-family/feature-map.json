  "date_result_normalization": "Compact reference date strings become YYYY-MM-DD HH:MM:SS, without changing fields; seven-component interval records remain ordered as defined in the feature.",
  "portable_profile": {
    "scope": "all four arithmetic draft features unless a scenario states an explicit zone or holiday override",
    "settings": {
      "language": "English",
      "character encoding": "ASCII",
      "local time zone": "Etc/UTC",
      "reference date-time": "2040-02-28 10:20:30 Etc/UTC",
      "numeric date order": "month before day",
      "omitted time": "midnight",
      "first weekday": "Monday",
      "first week": "the week containing January 4",
      "work week": "Monday through Friday",
      "work hours": "09:00 through 17:00",
      "24-hour workday": "disabled",
      "holidays": "none",
      "events": "none"
    },
    "interval_normalization_relationships": {
      "minute": "60 seconds",
      "hour": "60 minutes",
      "standard day": "24 hours",
      "standard week": "7 days",
      "year for year-month normalization": "12 months",
      "year for estimated conversion": "365.2425 days",
      "configured business day": "8 hours",
      "configured business week": "5 days"
    },
    "research_binding_source": "observation.profile_configuration; portable prose expands the relevant meanings instead of exporting native setting names",
    "evidence": {
      "native_profile_manifest": "docs/automation/reference-profiles.json",
      "observed_profile_carrier": "observations[].observation.profile_configuration",
      "normalization_case": "DELTA-FORMAT-ALL-RANGES",
      "normalization_carriers": [
        "request.initial",
        "request.patterns",
        "raw_return.list"
      ],
      "derivation": "The recorded conversion results establish 60 seconds/minute, 60 minutes/hour, 24 hours/day, 7 days/week, 12 months/year, and 31,556,952 seconds/year = 365.2425 days. The recorded WorkWeekBeg/End and WorkDayBeg/End settings establish five-day and eight-hour business units."
    }
  },
